nextcloud:
  host: {{ nextcloud_domain }}
  username: {{ nextcloud_admin_user }}
  password: "{{ nextcloud_admin_password }}"
  # Пользовательские файлы: inline NFS-том без PV/PVC — kubelet монтирует
  # экспорт напрямую в под, PV/PVC-объекты не создаются
  extraVolumes:
    - name: user-files
      nfs:
        server: {{ nfs_server_ip }}
        path: {{ nextcloud_nfs_share }}
  extraVolumeMounts:
    - name: user-files
      mountPath: {{ nextcloud_user_files_mount }}
  # Доп. конфиг: доверие заголовкам traefik (forwarded-for), https за
  # TLS-терминирующим прокси, окно обслуживания
  configs:
    proxy.config.php: |-
      <?php
      $CONFIG = array(
        'trusted_proxies' => array('{{ k3s_cluster_cidr }}'),
        'overwriteprotocol' => 'https',
        'overwrite.cli.url' => 'https://{{ nextcloud_domain }}',
        'maintenance_window_start' => {{ nextcloud_maintenance_window_start }},
      );

internalDatabase:
  enabled: false

postgresql:
  enabled: true
  auth:
    database: {{ nextcloud_db_name }}
    username: {{ nextcloud_db_user }}
    password: "{{ nextcloud_db_password }}"
  primary:
    persistence:
      enabled: true
      storageClass: {{ nextcloud_storage_class }}
      size: {{ nextcloud_storage.postgresql }}

persistence:
  enabled: true
  storageClass: {{ nextcloud_storage_class }}
  size: {{ nextcloud_storage.app }}

# Первичная инсталляция (rsync кода + maintenance:install) занимает минуты и
# не отвечает по HTTP; пока startupProbe не пройдёт, liveness/readiness не
# убивают под — иначе kubelet прерывает install и том остаётся полусобранным
startupProbe:
  enabled: true
  initialDelaySeconds: 10
  periodSeconds: 10
  failureThreshold: 60

# Sidecar-контейнер, дёргающий cron.php каждые 5 минут (фоновые задачи)
cronjob:
  enabled: true

ingress:
  enabled: true
  className: traefik
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    traefik.ingress.kubernetes.io/router.middlewares: "{{ nextcloud_namespace }}-hsts@kubernetescrd"
  tls:
    - secretName: nextcloud-tls
      hosts:
        - {{ nextcloud_domain }}
