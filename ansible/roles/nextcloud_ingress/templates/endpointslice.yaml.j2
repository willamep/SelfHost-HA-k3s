apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: {{ nextcloud_ingress_service_name }}-1
  namespace: {{ nextcloud_namespace }}
  labels:
    kubernetes.io/service-name: {{ nextcloud_ingress_service_name }}
addressType: IPv4
ports:
  - name: http
    port: {{ nextcloud_http_port }}
    protocol: TCP
endpoints:
  - addresses: ["{{ nextcloud_vm_ip }}"]
    conditions:
      ready: true
