# {{ ansible_managed }}
POSTGRES_HOST=db
POSTGRES_DB={{ nextcloud_db_name }}
POSTGRES_USER={{ nextcloud_db_user }}
POSTGRES_PASSWORD={{ nextcloud_db_password }}
# Redis: memcache.locking — обязательно, пока датадир на отдельном диске/ФС
REDIS_HOST=redis
# Первичная инсталляция выполняется entrypoint'ом образа из этих переменных
NEXTCLOUD_ADMIN_USER={{ nextcloud_admin_user }}
NEXTCLOUD_ADMIN_PASSWORD={{ nextcloud_admin_password }}
NEXTCLOUD_TRUSTED_DOMAINS={{ nextcloud_domain }} {{ nextcloud_vm_ip }}:{{ nextcloud_http_port }}
TRUSTED_PROXIES={{ allow_subnet }}
# TLS терминируется на traefik кластера
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://{{ nextcloud_domain }}
